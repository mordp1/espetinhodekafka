    {
      "id": 20,
      "type": "timeseries",
      "title": "Log size on disk per broker (bytes)",
      "description": "Kafka's own view (Strimzi Metrics Reporter). PVC free-space (kubelet_volume_stats_*) is what the KafkaRunningOutOfDisk alert uses on a real cluster, but kind's local-path volumes do not report it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kubernetes_pod_name) (kafka_log_log_size)",
          "legendFormat": "{{kubernetes_pod_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
