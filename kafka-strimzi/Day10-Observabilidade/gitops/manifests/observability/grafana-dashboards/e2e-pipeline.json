    {
      "id": 8,
      "type": "timeseries",
      "title": "Throughput by stage (msg/s)",
      "description": "The three lines should overlap. A line that falls away from the others shows WHERE the pipeline is losing speed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(demo_messages_produced_total{topic=\"orders\"}[1m]))",
          "legendFormat": "producer -> orders",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(demo_messages_consumed_total{stage=\"processor\"}[1m]))",
          "legendFormat": "processor consumed",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(demo_messages_consumed_total{stage=\"sink\"}[1m]))",
          "legendFormat": "sink consumed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "End-to-end latency (p50 / p95 / p99)",
